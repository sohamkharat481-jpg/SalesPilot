{
  "version": 2,
  "crons": [
    {
      "path": "/api/v1/outreach/cron-process-queue",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api?path=/auth/:path*"
    },
    {
      "source": "/gmail/:path*",
      "destination": "/api?path=/gmail/:path*"
    },
    {
      "source": "/calendar/:path*",
      "destination": "/api?path=/calendar/:path*"
    },
    {
      "source": "/organization/:path*",
      "destination": "/api?path=/organization/:path*"
    },
    {
      "source": "/team/:path*",
      "destination": "/api?path=/team/:path*"
    },
    {
      "source": "/((?!api/|auth/|gmail/|calendar/|organization/|team/|assets/|static/|favicon.ico|_next|vite.svg|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
