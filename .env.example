# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for real OpenAI API completions (optional, falls back to server-managed simulation/Gemini)
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CASHFREE_APP_ID: Merchant ID/App ID for Cashfree PG
CASHFREE_APP_ID="your_cashfree_app_id"

# CASHFREE_SECRET_KEY: Merchant Secret API Key used for signature verification & API calls
CASHFREE_SECRET_KEY="your_cashfree_secret_key"

# CASHFREE_ENV: Gateway environment - "sandbox" or "production"
CASHFREE_ENV="sandbox"

# B2B Lead Sourcing Provider API Keys
GOOGLE_MAPS_API_KEY=
PDL_API_KEY=
CLEARBIT_API_KEY=
HUNTER_API_KEY=
CRUNCHBASE_API_KEY=
SERPER_API_KEY=
LINKEDIN_SCRAPER_API_KEY=
ZOOMINFO_API_KEY=
DROPCONTACT_API_KEY=
BUILTWITH_API_KEY=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

